<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>MoleHill.Core</RootNamespace>
    <AssemblyName>MoleHill.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>1591;1572;1573;1574;0649;8600;8601;8602;8603;8604;8618;8625;8765;8767</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs;obj\Codex\**\*.cs;obj\CodexCheck\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <Compile Include="..\TriangleNet\**\*.cs"
             Exclude="..\TriangleNet\bin\**;..\TriangleNet\obj\**"
             LinkBase="TriangleNet" />
  </ItemGroup>
</Project>
