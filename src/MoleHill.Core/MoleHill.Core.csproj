<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>MoleHill.Core</RootNamespace>
    <AssemblyName>MoleHill.Core</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      Only the XML-doc and unassigned-field codes remain project-wide. The nullability codes used to be
      here for one reason: MoleHill.Core compiles the vendored TriangleNet sources directly, and they
      predate nullable reference types - 450 of the 456 warnings in the 2026-09-19 inventory were
      TriangleNet's. That suppression is now scoped to the vendor in .editorconfig
      (`[src/TriangleNet/**.cs] generated_code = true`), so owned code is analysed normally and
      `./validate.ps1 warnings` can hold it at zero.
    -->
    <NoWarn>1591;1572;1573;1574;0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="artifacts\**\*.cs;obj\Codex\**\*.cs;obj\CodexCheck\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="2.0.0" />
    <Compile Include="..\TriangleNet\**\*.cs"
             Exclude="..\TriangleNet\bin\**;..\TriangleNet\obj\**"
             LinkBase="TriangleNet" />
  </ItemGroup>
</Project>
