<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <RootNamespace>MoleHill.Rhino</RootNamespace>
    <AssemblyName>MoleHill.Rhino</AssemblyName>
    <Version>$(MoleHillVersion)</Version>
    <InformationalVersion>$(MoleHillVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>MoleHill Rhino</Title>
    <Company>MoleHill Authors</Company>
    <Authors>rheinason</Authors>
    <Description>Primary Rhino plugin for MoleHill terrain creation, grading, and analysis workflows.</Description>
    <RepositoryUrl>https://github.com/rheinason/MoleHill</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rheinason/MoleHill</PackageProjectUrl>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>CA1416;NETSDK1086;NU1701</NoWarn>
      <!-- One pointer write in RhinoGeometryConversions.FillMesh: adding faces one call at a time cost
         ~5 ms per 100k-face mesh, in every stage that builds one. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <!-- 8.9 is the compatibility FLOOR: the plug-in must load on any Rhino 8.9+, so it compiles
         against the oldest supported RhinoCommon and takes the runtime assembly from the host
         (ExcludeAssets="runtime"). PrivateAssets="all" stops that floor flowing to consumers:
         the test projects load a real Rhino and must bind to the INSTALLED RhinoCommon, not to
         this one. Without it they inherit 8.9 transitively and mismatch the native runtime. -->
    <PackageReference Include="RhinoCommon" Version="8.9.24194.18121" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoleHill.Core\MoleHill.Core.csproj" />
    <ProjectReference Include="..\MoleHill.Interop\MoleHill.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing.Common">
      <HintPath>$(WindowsDesktopRefPackDir)\System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="EmbeddedResources\plugin-utility.ico" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Toolbars\icons\ is generator source only: generate-toolbar-icons.ps1 packs those PNGs into
         the .rui's sprite strips, so shipping them again would be dead weight in the plugin. -->
    <Content Include="Toolbars\**\*" Exclude="Toolbars\icons\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Import Project="..\MoleHill.Shared\MoleHill.Shared.props" />
</Project>
