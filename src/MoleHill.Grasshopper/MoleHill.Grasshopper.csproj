<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net7.0</TargetFrameworks>
    <RootNamespace>MoleHill.Grasshopper</RootNamespace>
    <AssemblyName>MoleHill</AssemblyName>
    <TargetExt>.gha</TargetExt>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>NU1701;CA1416;NETSDK1086</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ILRepackTargetsFile>$(MSBuildProjectDirectory)\ILRepackCustom.targets</ILRepackTargetsFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(MoleHillVersion)</Version>
    <InformationalVersion>$(MoleHillVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>MoleHill Grasshopper</Title>
    <Company>MoleHill Authors</Company>
    <Authors>rheinason</Authors>
    <Description>Optional Grasshopper components for the MoleHill Rhino terrain workflow.</Description>
    <RepositoryUrl>https://github.com/rheinason/MoleHill</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rheinason/MoleHill</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoleHill.Core\MoleHill.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\MoleHill.Shared\InSituStairReferenceBuilder.cs" Link="Shared\InSituStairReferenceBuilder.cs" />
    <Compile Include="..\MoleHill.Shared\AdaptivePolylineBuilder.cs" Link="Shared\AdaptivePolylineBuilder.cs" />
    <Compile Include="..\MoleHill.Shared\RetainingWallBrepBuilder.cs" Link="Shared\RetainingWallBrepBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.9.24194.18121" ExcludeAssets="runtime" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyToGrasshopper" AfterTargets="MergeAssemblies"
          Condition="'$(TargetFramework)' == 'net7.0-windows' and '$(SkipGrasshopperLibraryCopy)' != 'True'">
    <PropertyGroup>
      <GHLibDir>$(APPDATA)\Grasshopper\Libraries\</GHLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(GHLibDir)" />
    <Copy SourceFiles="$(OutputPath)MoleHill.gha" DestinationFolder="$(GHLibDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <Target Name="BuildYakPackage" AfterTargets="MergeAssemblies"
          Condition="'$(TargetFramework)' == 'net7.0-windows'">
    <PropertyGroup>
      <YakExecutable Condition="$(YakExecutable) == '' and Exists('C:\Program Files\Rhino 8\System\Yak.exe')">C:\Program Files\Rhino 8\System\Yak.exe</YakExecutable>
      <BuildYakPackage Condition="$(BuildYakPackage) == '' and $(YakExecutable) != ''">False</BuildYakPackage>
    </PropertyGroup>
    <Warning Text="Could not find Yak executable" Condition="$(YakExecutable) == ''" />
    <ItemGroup>
      <YakPackagesToDelete Include="$(OutputPath)\*.yak;$(OutputPath)\**\manifest.yml" />
    </ItemGroup>
    <Delete Files="@(YakPackagesToDelete)" />
    <Exec Command="&quot;$(YakExecutable)&quot; spec --input &quot;$(OutputPath)MoleHill.gha&quot; --output &quot;$(OutputPath)&quot;" WorkingDirectory="$(OutputPath)" Condition="$(BuildYakPackage) == 'True'" />
    <Exec Command="&quot;$(YakExecutable)&quot; build --platform win" WorkingDirectory="$(OutputPath)" Condition="$(BuildYakPackage) == 'True'" />
  </Target>
</Project>
