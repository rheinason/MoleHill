<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net7.0-windows;net7.0</TargetFrameworks>
    <RootNamespace>MoleHill.Grasshopper</RootNamespace>
    <AssemblyName>MoleHill</AssemblyName>
    <TargetExt>.gha</TargetExt>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>NU1701;CA1416;NETSDK1086</NoWarn>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ILRepackTargetsFile>$(MSBuildProjectDirectory)\ILRepackCustom.targets</ILRepackTargetsFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(MoleHillVersion)</Version>
    <InformationalVersion>$(MoleHillVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Title>MoleHill Grasshopper</Title>
    <Company>MoleHill Authors</Company>
    <Authors>rheinason</Authors>
    <Description>Optional Grasshopper components for the MoleHill Rhino terrain workflow.</Description>
    <RepositoryUrl>https://github.com/rheinason/MoleHill</RepositoryUrl>
    <PackageProjectUrl>https://github.com/rheinason/MoleHill</PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoleHill.Core\MoleHill.Core.csproj" />
    <ProjectReference Include="..\MoleHill.Interop\MoleHill.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <Import Project="..\MoleHill.Shared\MoleHill.Shared.props" />

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.9.24194.18121" ExcludeAssets="runtime" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34.2" />
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" ExcludeAssets="runtime" />
  </ItemGroup>

  <Target Name="CopyToGrasshopper" AfterTargets="MergeAssemblies"
          Condition="'$(TargetFramework)' == 'net7.0-windows' and '$(SkipGrasshopperLibraryCopy)' != 'True'">
    <PropertyGroup>
      <GHLibDir>$(APPDATA)\Grasshopper\Libraries\</GHLibDir>
    </PropertyGroup>
    <MakeDir Directories="$(GHLibDir)" />
    <Copy SourceFiles="$(OutputPath)MoleHill.gha" DestinationFolder="$(GHLibDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
    <Copy SourceFiles="$(OutputPath)MoleHill.Interop.dll" DestinationFolder="$(GHLibDir)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <!-- There is deliberately no Yak target here. One used to live in this file: it invoked
       `yak spec` with the merged MoleHill.gha as its input, so yak inspected the *Grasshopper*
       assembly and emitted a Grasshopper-only manifest over an output folder holding only the .gha.
       The package it produced looked publishable and was published as 0.14.3-beta, which installed
       cleanly, gave Grasshopper its components, and left Rhino's PlugInManager empty because the
       archive contained no .rhp. A Yak version can never be overwritten, so that had to be corrected
       by shipping a new version.

       build-yak-package.ps1 is the only packaging path. It stages the .rhp alongside the .gha and
       asserts on the built archive's contents before it will push. -->
</Project>
