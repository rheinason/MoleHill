<Project>
  <!-- Use a unique name to avoid being overridden by the NuGet package -->
  <Target Name="MergeAssemblies" AfterTargets="Build">
    <PropertyGroup>
      <MoleHillILRepackDirectory>$([System.IO.Path]::Combine($([System.IO.Path]::GetTempPath()), 'MoleHillILRepack', '$(MSBuildProjectName)', '$(TargetFramework)'))\</MoleHillILRepackDirectory>
      <MoleHillILRepackOutputFile>$(MoleHillILRepackDirectory)$(TargetName)$(TargetExt)</MoleHillILRepackOutputFile>
    </PropertyGroup>

    <ItemGroup>
      <InputAssemblies Include="$(OutputPath)$(TargetName)$(TargetExt)" />
      <InputAssemblies Include="$(OutputPath)MoleHill.Core.dll" />
      <!-- Search directories for resolving referenced (but not merged) assemblies such as Grasshopper
           and RhinoCommon, which are ExcludeAssets=runtime and therefore not copied to OutputPath. -->
      <ILRepackSearchDir Include="$(OutputPath)" />
      <ILRepackSearchDir Include="@(ReferencePath->'%(RootDir)%(Directory)')" />
    </ItemGroup>

    <MakeDir Directories="$(MoleHillILRepackDirectory)" />

    <ILRepack
      Parallel="false"
      DebugInfo="true"
      AllowDuplicateResources="false"
      InputAssemblies="@(InputAssemblies)"
      LibraryPath="@(ILRepackSearchDir->Distinct())"
      TargetKind="SameAsPrimaryAssembly"
      OutputFile="$(MoleHillILRepackOutputFile)" />

    <Copy SourceFiles="$(MoleHillILRepackOutputFile)" DestinationFiles="$(OutputPath)$(TargetName)$(TargetExt)" OverwriteReadOnlyFiles="true" />

    <Delete Files="$(OutputPath)MoleHill.Core.dll;$(OutputPath)MoleHill.Core.pdb" ContinueOnError="true" Condition="'$(Configuration)' == 'Release'" />
    <Delete Files="$(MoleHillILRepackOutputFile)" ContinueOnError="true" />
  </Target>
</Project>
