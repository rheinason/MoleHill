<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <None Include="Fixtures\legacy-snapshot-20260914.gh" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
    <!-- No RhinoCommon package pin. These tests load the real Rhino: managed RhinoCommon, native
         rhcommon_c.dll and the installed Grasshopper are a version-locked set, so the reference
         below takes RhinoCommon from $(RhinoSystemDir) and it always matches whatever Rhino is
         installed. A pinned version is wrong the moment Rhino updates itself: 8.34 managed
         against 8.35 native failed at load with ERROR_DLL_INIT_FAILED (0x8007045A), and against
         8.35 Grasshopper it failed to compile with CS1705. The 8.9 compatibility floor is the
         src projects' job and is asserted there. -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Grasshopper">
      <HintPath>$(RhinoGrasshopperDir)\Grasshopper.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="GH_IO">
      <HintPath>$(RhinoGrasshopperDir)\GH_IO.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoleHill.Core\MoleHill.Core.csproj" />
    <ProjectReference Include="..\..\src\MoleHill.Interop\MoleHill.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\MoleHill.Grasshopper\MoleHillInfo.cs" Link="Grasshopper\MoleHillInfo.cs" />
    <Compile Include="..\..\src\MoleHill.Grasshopper\Components\*.cs" LinkBase="Grasshopper\Components" />
    <Compile Include="..\..\src\MoleHill.Grasshopper\Types\*.cs" LinkBase="Grasshopper\Types" />
    <Compile Include="..\..\src\MoleHill.Grasshopper\Utilities\*.cs" LinkBase="Grasshopper\Utilities" />
    <Compile Include="..\..\src\MoleHill.Grasshopper\Registry\*.cs" LinkBase="Grasshopper\Registry" />
  </ItemGroup>

  <Import Project="..\..\src\MoleHill.Shared\MoleHill.Shared.props" />
</Project>
