<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <!-- No RhinoCommon package pin. These tests load the real Rhino: managed RhinoCommon, native
         rhcommon_c.dll and the installed Grasshopper are a version-locked set, so the reference
         below takes RhinoCommon from $(RhinoSystemDir) and it always matches whatever Rhino is
         installed. A pinned version is wrong the moment Rhino updates itself: 8.34 managed
         against 8.35 native failed at load with ERROR_DLL_INIT_FAILED (0x8007045A), and against
         8.35 Grasshopper it failed to compile with CS1705. The 8.9 compatibility floor is the
         src projects' job and is asserted there. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoleHill.Core\MoleHill.Core.csproj" />
    <ProjectReference Include="..\..\src\MoleHill.Interop\MoleHill.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RhinoSystemDir)\rhcommon_c.dll">
      <Link>rhcommon_c.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- One benchmark gate for every lane, so a performance run states what it actually executed.
         Linked rather than copied: two gates would drift and a skipped body reads as a pass. -->
    <Compile Include="..\MoleHill.Core.Tests\PerformanceLane.cs" Link="PerformanceLane.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\AdaptivePolylineBuilder.cs" Link="Shared\AdaptivePolylineBuilder.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\InSituStairReferenceBuilder.cs" Link="Shared\InSituStairReferenceBuilder.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\RetainingWallBrepBuilder.cs" Link="Shared\RetainingWallBrepBuilder.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\RetainingWallGradePlanner.cs" Link="Shared\RetainingWallGradePlanner.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\RetainingWallPlannerCore.cs" Link="Shared\RetainingWallPlannerCore.cs" />
    <Compile Include="..\..\src\MoleHill.Shared\ModelUnitContext.cs" Link="Shared\ModelUnitContext.cs" />
    <Compile Include="..\..\src\MoleHill.Rhino\Model\*.cs" LinkBase="Model" />
    <Compile Include="..\..\src\MoleHill.Rhino\Registry\*.cs" LinkBase="Registry" />
    <Compile Include="..\..\src\MoleHill.Rhino\Services\*.cs" LinkBase="Services"
             Exclude="..\..\src\MoleHill.Rhino\Services\BlockCommandService.cs;..\..\src\MoleHill.Rhino\Services\CurveReviewService.cs;..\..\src\MoleHill.Rhino\Services\CurveReviewForm.cs;..\..\src\MoleHill.Rhino\Services\CurveReviewRuleStore.cs;..\..\src\MoleHill.Rhino\Services\CurveReviewLabeller.cs;..\..\src\MoleHill.Rhino\Services\GeometryCommandService.cs;..\..\src\MoleHill.Rhino\Services\DocumentCommandService.cs;..\..\src\MoleHill.Rhino\Services\LandXmlSurfaceService.cs;..\..\src\MoleHill.Rhino\Services\LayerTemplateCommandService.cs;..\..\src\MoleHill.Rhino\Services\SculptSessionController.cs;..\..\src\MoleHill.Rhino\Services\SurveyImportCommandService.cs;..\..\src\MoleHill.Rhino\Services\SurveyPlacement.cs;..\..\src\MoleHill.Rhino\Services\TerrainController*.cs;..\..\src\MoleHill.Rhino\Services\TerrainDisplayConduit.cs;..\..\src\MoleHill.Rhino\Services\TerrainRenderMeshProvider.cs;..\..\src\MoleHill.Rhino\Services\TerrainGrasshopperBridge.cs;..\..\src\MoleHill.Rhino\Services\TerrainInputCommandService.cs;..\..\src\MoleHill.Rhino\Services\ToolbarInstaller.cs" />
  </ItemGroup>

</Project>
