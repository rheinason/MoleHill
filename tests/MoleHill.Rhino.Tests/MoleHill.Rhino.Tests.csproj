<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
      <!-- One pointer write in RhinoGeometryConversions.FillMesh: adding faces one call at a time cost
         ~5 ms per 100k-face mesh, in every stage that builds one. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <!-- No RhinoCommon package pin. These tests load the real Rhino: managed RhinoCommon, native
         rhcommon_c.dll and the installed Grasshopper are a version-locked set, so the reference
         below takes RhinoCommon from $(RhinoSystemDir) and it always matches whatever Rhino is
         installed. A pinned version is wrong the moment Rhino updates itself: 8.34 managed
         against 8.35 native failed at load with ERROR_DLL_INIT_FAILED (0x8007045A), and against
         8.35 Grasshopper it failed to compile with CS1705. The 8.9 compatibility floor is the
         src projects' job and is asserted there. -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="RhinoCommon">
      <HintPath>$(RhinoSystemDir)\RhinoCommon.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MoleHill.Core\MoleHill.Core.csproj" />
    <ProjectReference Include="..\..\src\MoleHill.Interop\MoleHill.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RhinoSystemDir)\rhcommon_c.dll">
      <Link>rhcommon_c.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- One benchmark gate for every lane, so a performance run states what it actually executed.
         Linked rather than copied: two gates would drift and a skipped body reads as a pass. -->
    <Compile Include="..\MoleHill.Core.Tests\PerformanceLane.cs" Link="PerformanceLane.cs" />
    <Compile Include="..\..\src\MoleHill.Rhino\Model\*.cs" LinkBase="Model" />
    <Compile Include="..\..\src\MoleHill.Rhino\Registry\*.cs" LinkBase="Registry" />
    <Compile Include="..\..\src\MoleHill.Rhino\Services\**\*.cs" LinkBase="Services"
             Exclude="..\..\src\MoleHill.Rhino\Services\Commands\BlockCommandService.cs;..\..\src\MoleHill.Rhino\Services\CurveReview\CurveReviewService.cs;..\..\src\MoleHill.Rhino\Services\CurveReview\CurveReviewForm.cs;..\..\src\MoleHill.Rhino\Services\CurveReview\CurveReviewRuleStore.cs;..\..\src\MoleHill.Rhino\Services\CurveReview\CurveReviewLabeller.cs;..\..\src\MoleHill.Rhino\Services\Commands\GeometryCommandService.cs;..\..\src\MoleHill.Rhino\Services\Commands\DocumentCommandService.cs;..\..\src\MoleHill.Rhino\Services\Import\LandXmlSurfaceService.cs;..\..\src\MoleHill.Rhino\Services\Commands\LayerTemplateCommandService.cs;..\..\src\MoleHill.Rhino\Services\Sculpt\SculptSessionController.cs;..\..\src\MoleHill.Rhino\Services\Commands\SurveyImportCommandService.cs;..\..\src\MoleHill.Rhino\Services\Import\SurveyPlacement.cs;..\..\src\MoleHill.Rhino\Services\Controller\TerrainController*.cs;..\..\src\MoleHill.Rhino\Services\Display\TerrainDisplayConduit.cs;..\..\src\MoleHill.Rhino\Services\Display\TerrainRenderMeshProvider.cs;..\..\src\MoleHill.Rhino\Services\Controller\TerrainGrasshopperBridge.cs;..\..\src\MoleHill.Rhino\Services\Commands\TerrainInputCommandService.cs;..\..\src\MoleHill.Rhino\Services\Commands\ToolbarInstaller.cs" />
  </ItemGroup>

  <Import Project="..\..\src\MoleHill.Shared\MoleHill.Shared.props" />
</Project>
