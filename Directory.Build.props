<Project>
  <PropertyGroup>
    <MoleHillVersion>1.3.0-beta</MoleHillVersion>
    <BuildInParallel>false</BuildInParallel>

    <!--
      Host installation paths. The Rhino plugin and both host test projects reference assemblies from an
      installed Rhino rather than from packages, so the path has to exist somewhere; keeping it here
      means it is declared configuration in one file instead of an absolute developer path buried in
      four csprojs. Override on another machine with `-p:RhinoInstallDir=...` or the matching
      environment variable. See docs/validation-lanes.md.
    -->
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == '' and '$(MOLEHILL_RHINO_DIR)' != ''">$(MOLEHILL_RHINO_DIR)</RhinoInstallDir>
    <RhinoInstallDir Condition="'$(RhinoInstallDir)' == ''">C:\Program Files\Rhino 8</RhinoInstallDir>
    <RhinoSystemDir Condition="'$(RhinoSystemDir)' == ''">$(RhinoInstallDir)\System</RhinoSystemDir>
    <RhinoGrasshopperDir Condition="'$(RhinoGrasshopperDir)' == ''">$(RhinoInstallDir)\Plug-ins\Grasshopper</RhinoGrasshopperDir>

    <!--
      The WindowsDesktop reference pack that supplies System.Drawing.Common to the net7.0 Rhino plugin.
      Pinned to a patch that ships the net7.0 ref assemblies; override if the installed pack differs.
    -->
    <WindowsDesktopRefPackDir Condition="'$(WindowsDesktopRefPackDir)' == '' and '$(MOLEHILL_WINDOWSDESKTOP_REF_DIR)' != ''">$(MOLEHILL_WINDOWSDESKTOP_REF_DIR)</WindowsDesktopRefPackDir>
    <WindowsDesktopRefPackDir Condition="'$(WindowsDesktopRefPackDir)' == ''">$(ProgramFiles)\dotnet\packs\Microsoft.WindowsDesktop.App.Ref\7.0.20\ref\net7.0</WindowsDesktopRefPackDir>
  </PropertyGroup>
</Project>
